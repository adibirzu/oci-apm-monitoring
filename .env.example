# OCI APM Configuration
# Copy this to .env.local and fill in your values
OCI_APM_ENDPOINT=https://<apm-domain>.apm-agt.<region>.oci.oraclecloud.com
OCI_APM_PUBLIC_DATAKEY=<your-public-data-key>
OCI_APM_PRIVATE_DATAKEY=<your-private-data-key>
LOG_ANALYTICS_NAMESPACE=<your-la-namespace>
LOG_ANALYTICS_LOG_GROUP_ID=<your-log-group-ocid>
